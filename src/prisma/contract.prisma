enum DiscountType {
  @@type("pg/text@1")
  PERCENTAGE = "PERCENTAGE"
  FIXED = "FIXED"
}

enum ReviewStatus {
  @@type("pg/text@1")
  PENDING = "PENDING"
  APPROVED = "APPROVED"
  REJECTED = "REJECTED"
}

enum OrderStatus {
  @@type("pg/text@1")
  PENDING = "PENDING"
  PAID = "PAID"
  CANCELLED = "CANCELLED"
  REFUNDED = "REFUNDED"
}

// Better Auth owns these four tables directly (src/prisma/auth-schema.sql),
// outside this contract's normal ownership. They're declared here only so
// `db update`/`migration plan` recognize them as intentionally-present and
// never plan a DROP for them — @@control(external) means "expected to
// exist, no DDL" (the same policy Supabase's own auth/storage tables use).
// Everything else in this contract stores the Better Auth user id as a
// plain string field — no Prisma-level relation to these models.

model User {
  id            String  @id
  name          String
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?
  role          String  @default("CUSTOMER")

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@control(external)
}

model Session {
  id        String @id
  userId    String
  token     String @unique
  expiresAt TimestamptzString
  ipAddress String?
  userAgent String?

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@control(external)
}

model Account {
  id                    String  @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  TimestamptzString?
  refreshTokenExpiresAt TimestamptzString?
  scope                 String?
  password              String?

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@control(external)
}

model Verification {
  id         String @id
  identifier String
  value      String
  expiresAt  TimestamptzString

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@control(external)
}

// Digital products (Excel/Google Sheets trackers): no shipping, no physical
// variants, no stock. A product is bought once and unlocks `digitalAccessUrl`
// (or the uploaded `digitalFileKey`) for the buyer.

model Product {
  id               String  @id @default(uuid())
  name             String
  // Compact label for cards, carts and order rows where the full name is too long.
  shortName        String?
  slug             String  @unique
  description      String?
  // Both in paise. `originalPrice` is the strike-through "was" price and is
  // only rendered when it's greater than `price`.
  price            Int
  originalPrice    Int?
  badge            String?
  // Presentation hints mirrored from the catalog source: `iconName` is a
  // lucide-react export name, `color` a key in PRODUCT_ACCENTS (lib/product-accent).
  iconName         String?
  color            String?
  // Retired products stay in the table so past buyers keep their download
  // access; only active ones are listed on the storefront.
  isActive         Boolean @default(true)
  // External link fallback (Drive/Dropbox/etc) — used if digitalFileKey isn't set.
  digitalAccessUrl String?
  // Cloudflare R2 object key for an uploaded PDF/ZIP. When set, the access
  // endpoint generates a short-lived presigned download URL instead of
  // redirecting to digitalAccessUrl.
  digitalFileKey   String?
  digitalFileName  String?

  // Lets seeded/migrated social proof (from before this system existed)
  // display without faking individual Review rows. When set, the storefront
  // shows these instead of the live Review aggregate.
  ratingOverride      Float?
  reviewCountOverride Int?

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

// Ordered selling-point bullets shown on the product page. A join model
// rather than a `String[]` column: the SQL interpreter rejects scalar lists.

model ProductFeature {
  id        String @id @default(uuid())
  productId String
  label     String
  position  Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  url       String
  alt       String?
  // Gallery order; the first image is the cover.
  position  Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Review {
  id        String       @id @default(uuid())
  productId String
  userId    String
  orderId   String
  rating    Int
  comment   String?
  status    ReviewStatus @default(PENDING)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt TimestamptzString @default(now())

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
}

model Wishlist {
  id        String @id @default(uuid())
  userId    String
  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt TimestamptzString @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model Coupon {
  id                String       @id @default(uuid())
  code              String       @unique
  discountType      DiscountType
  discountValue     Int
  minOrderAmount    Int          @default(0)
  maxDiscountAmount Int?
  usageLimit        Int?
  perCustomerLimit  Int?
  startsAt          TimestamptzString?
  expiresAt         TimestamptzString?
  active            Boolean      @default(true)

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model AuditLog {
  id           String  @id @default(uuid())
  actorUserId  String
  action       String
  entityType   String
  entityId     String
  beforeValue  String?
  afterValue   String?

  createdAt TimestamptzString @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId])
}

model Order {
  id             String      @id @default(uuid())
  userId         String
  email          String?
  status         OrderStatus @default(PENDING)
  subtotal       Int
  discountAmount Int         @default(0)
  couponCode     String?
  total          Int

  // Legacy identifiers retained for audit history; new orders use Cashfree.
  razorpayOrderId   String? @unique
  razorpayPaymentId String?

  cashfreeOrderId   String? @unique
  cashfreePaymentId String?
  paymentEnvironment String?
  paymentStatus    String @default("NOT_STARTED")
  customerPhone    String?
  refundedAmount   Int @default(0)
  lastPaymentSyncAt TimestamptzString?
  // Landing page slug the order was placed from; null for the main store.
  source           String?
  // Ad attribution carried from the landing page to checkout (see landingEvent).
  visitorId        String?
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  utmContent       String?

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@index([userId])
}

model OrderItem {
  id          String @id @default(uuid())
  orderId     String
  productId   String
  productName String
  quantity    Int
  unitPrice   Int
  finalPrice  Int
  // Set when the product was bought as part of a combo. The combo price is
  // split across its products in proportion to their prices, so per-product
  // revenue stays meaningful; the name is a snapshot for the order history.
  offerId     String?
  offerName   String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
}


// One row per gateway attempt. Failure does not cancel the parent order.
model PaymentAttempt {
  id String @id
  orderId String
  status String
  amount Int
  currency String
  message String?
  paymentTime TimestamptzString
  updatedAt temporal.updatedAtString()
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@index([orderId])
}

model PaymentRefund {
  id String @id
  orderId String
  amount Int
  status String
  gatewayRefundId String?
  paymentId String?
  refundType String @default("MERCHANT_INITIATED")
  message String?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@index([orderId])
}

// Minimal audit receipts; never store bank/card details or full webhook bodies.
model PaymentEvent {
  id String @id
  orderId String
  type String
  source String
  summary String
  createdAt TimestamptzString @default(now())
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@index([orderId])
}

// A durable notification record, committed with payment confirmation.
model PaymentEmail {
  id String @id
  orderId String
  kind String
  sentAt TimestamptzString?
  attempts Int @default(0)
  createdAt TimestamptzString @default(now())
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@index([orderId])
}

// A combo: several products sold together at one price (in paise).
model Offer {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  price       Int
  badge       String?
  isActive    Boolean @default(true)
  position    Int     @default(0)

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model OfferItem {
  id        String @id @default(uuid())
  offerId   String
  productId String
  position  Int    @default(0)

  offer   Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([offerId, productId])
  @@index([productId])
}

// A focused sales page for one product, optionally served on its own domain.
// `content` is JSON validated by lib/landing (sections change without migrations).
model LandingPage {
  id        String  @id @default(uuid())
  slug      String  @unique
  name      String
  productId String
  domain    String? @unique
  isActive  Boolean @default(false)
  content   String  @default("{}")

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

// One tracked step of a landing-page visit: "view", "scroll" (read half the
// page), "cta" (clicked buy) or "checkout" (reached checkout on the main site).
// Purchases aren't events — they're orders carrying the same source/visitorId.
model LandingEvent {
  id          String  @id @default(uuid())
  landingSlug String
  type        String
  visitorId   String
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  referrer    String?
  device      String?
  country     String?

  createdAt TimestamptzString @default(now())

  @@index([landingSlug, createdAt])
  @@index([visitorId])
}
